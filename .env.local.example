# Bip & Bouffe — variables d'environnement
# Sur Netlify : Site settings → Environment variables
# (ne pas committer .env)

COOKING_SPREADSHEET_ID=

# Compte de service Google (API Sheets)
# Seuls GG_client_email + GG_private_key sont vraiment secrets.
GG_client_email=
GG_private_key=

# Front : laisser VIDE — les appels vont sur /api/* (Netlify Functions)
# Ne pas mettre http://localhost:3001
VITE_API_URL=

# Serveur local optionnel uniquement pour scripts Node (npm run server)
API_PORT=3001
